<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CursoApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CursoApp.Views"
    Title="CursoApp">

    <ShellContent Title="Login" ContentTemplate="{DataTemplate local:Login}" Route="Login" Shell.FlyoutItemIsVisible="False" Shell.FlyoutBehavior="Disabled" />

    <FlyoutItem Title="Lens">
        <ShellContent Title="MainPage"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Proximamente...">
        <ShellContent Title="Proximamente"
                      ContentTemplate="{DataTemplate local:Proximamente}"
                      Route="Proximamente"/>
    </FlyoutItem>
    <FlyoutItem Title="Cerrar Sesion">
        <ShellContent Title="Login"
                      ContentTemplate="{DataTemplate local:Login}"
                      Route="Login"/>
    </FlyoutItem>
</Shell>
