<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CursoApp.ViewsModel"
             x:Class="CursoApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="AppLens"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="24" RowSpacing="18">
        
        <Label Grid.Row="0" Text="Mi App" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" 
               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
        
        <Label Grid.Row="1" Text="Opciones y Configuraciones" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" 
               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

        <ScrollView Grid.Row="2" Orientation="Horizontal" IsVisible="True">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Button Text="Capturar Imagen" HeightRequest="15" CornerRadius="14" FontAttributes="Bold" FontSize="12"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" Shadow="{Shadow Brush=Black, Offset='0,2', Radius='4'}" Command="{Binding CapturarFotoCommand}"/>

                <Button Text="Seleccionar Imagen de Galeria" HeightRequest="15" CornerRadius="14" FontSize="12" BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" Shadow="{Shadow Brush=Black, Offset='0,2', Radius='4'}" Command="{Binding SeleccionaImagenGaleria}"/>

                <Picker Title="Selecciona un modelo de IA"
                    ItemsSource="{Binding ListaModelos}"
                    SelectedItem="{Binding ModeloSeleccionado}"
                    BackgroundColor="{AppThemeBinding Light='#F0F0F0', Dark='#222222'}"
                    TextColor="{AppThemeBinding Light='Black', Dark='White'}"
                    HeightRequest="40"
                    VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </ScrollView>

        <Border Grid.Row="3"
                HeightRequest="210" StrokeShape="RoundRectangle 16" StrokeThickness="0" 
                IsVisible="{Binding TieneImagen}" BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
            <Image Source="{Binding ImagenCapturada}" Aspect="AspectFill" />
        </Border>

        <Grid Grid.Row="4" RowDefinitions="Auto, *, Auto" ColumnSpacing="8">

            <ScrollView Grid.Row="0" Orientation="Horizontal" IsVisible="{Binding TieneImagen}">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Button Command="{Binding EjecutarAccionCommand}" Text="Explicar" CommandParameter="Explicar" CornerRadius="20" HeightRequest="40" FontSize="13" />
                    <Button Command="{Binding EjecutarAccionCommand}" Text="Traducir" CommandParameter="Traducir" CornerRadius="20" HeightRequest="40" FontSize="13" />
                    <Button Command="{Binding EjecutarAccionCommand}" Text="Buscar" CommandParameter="Buscar" CornerRadius="20" HeightRequest="40" FontSize="13" />                
                    <Button Command="{Binding LeerVozCommand}" Text="Leer Con Voz" CommandParameter="LeerVoz" CornerRadius="20" HeightRequest="40" FontSize="13" />                
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Grid.Row="1">
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2C2C2C'}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}" Padding="18" Margin="0,4,0,4">

                <Label Text="{Binding ResultadoTexto}" TextColor="{AppThemeBinding Light='#333333', Dark='#E0E0E0'}" FontSize="15" LineHeight="1.3" LineBreakMode="WordWrap"/>
                </Border>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="8" IsVisible="{Binding TieneImagen}">
                <Entry Grid.Column="0"
                       Placeholder="Pregunta algo mas sobre la imagen..." HeightRequest="48" BackgroundColor="{AppThemeBinding Light='White', Dark='#1A1A1A'}"
                       TextColor="{AppThemeBinding Light='#333333', Dark='#E0E0E0'}" Text="{Binding TextoPreguntaChat}"/>
                <Button Grid.Column="1" Text="➤"  WidthRequest="48" HeightRequest="48" CornerRadius="24" BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold" 
                       Command="{Binding EnviarMensajeChatCommand}" />
            </Grid>
        </Grid>
     </Grid>

</ContentPage>
